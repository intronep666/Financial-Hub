# Kryptos Finance Backend - Production Environment Configuration
# Copy this file to .env or use it as a template for production environment values

# ============== APPLICATION ==============
APP_NAME=Kryptos Finance API
APP_VERSION=2.0.0
DEBUG=false
ENVIRONMENT=production

# ============== SECURITY ==============
# Generate a secure secret; e.g. on Linux: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-production-secret-key-here

# ============== DATABASE ==============
# Recommended: use a production Postgres instance
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/financial_hub
USE_SQLITE=false
SQLITE_URL=sqlite:///./finance.db

# ============== BACKGROUND JOBS (Celery/Redis) ==============
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=${REDIS_URL}
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ============== OBSERVABILITY ==============
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2

# ============== COOKIE SETTINGS ==============
COOKIE_SECURE=true
COOKIE_HTTPONLY=true
COOKIE_SAMESITE=lax

# ============== AI/ML SERVICES ==============
AI_SERVICE_URL=http://ai-service:8001
AI_MODEL_CATEGORIZATION=expense-categorization-v1
AI_MODEL_PREDICTION=spending-prediction-v1

# ============== SPEECH-TO-TEXT ==============
SPEECH_TO_TEXT_SERVICE=google
SPEECH_TO_TEXT_API_KEY=

# ============== CORS ==============
# Allowed origins for the production deployment
CORS_ORIGINS=["https://your-production-frontend-domain.com"]
