# Kryptos Finance Backend - Environment Configuration
# Copy this file to .env and fill in your values

# ============== APPLICATION ==============
APP_NAME=Kryptos Finance API
APP_VERSION=2.0.0
DEBUG=false

# ============== SECURITY ==============
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here-change-this-in-production

# ============== DATABASE ==============
# For PostgreSQL (Production)
DATABASE_URL=postgresql://username:password@localhost:5432/financial_hub

# For SQLite (Development)
USE_SQLITE=false
SQLITE_URL=sqlite:///./finance.db

# Skip DB initialization (Base.metadata.create_all + light migrations) on app startup
# For dev/CI (fast imports), set SKIP_DB_INIT=true; for first run with an empty DB or to apply
# light migrations via startup, set SKIP_DB_INIT=false
SKIP_DB_INIT=true

# ============== BACKGROUND JOBS (Celery/Redis) ==============
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=${REDIS_URL}
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ============== OBSERVABILITY ==============
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2
ENVIRONMENT=development

# ============== COOKIE SETTINGS ==============
COOKIE_SECURE=true  # Set to false for localhost development
COOKIE_HTTPONLY=true
COOKIE_SAMESITE=lax

# ============== KAFKA/KINESIS STREAMING ==============
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# OR for AWS Kinesis:
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key

# ============== AI/ML SERVICES ==============
AI_SERVICE_URL=http://localhost:8001
AI_MODEL_CATEGORIZATION=expense-categorization-v1
AI_MODEL_PREDICTION=spending-prediction-v1

# ============== SPEECH-TO-TEXT ==============
SPEECH_TO_TEXT_SERVICE=google  # google, azure, or aws
SPEECH_TO_TEXT_API_KEY=your-api-key-here

# Google Cloud
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/credentials.json

# Azure
# AZURE_SPEECH_KEY=your-azure-key
# AZURE_SPEECH_REGION=eastus

# AWS
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_REGION=us-east-1

# ============== CORS ==============
CORS_ORIGINS=["http://localhost:3000","https://your-production-domain.com"]
