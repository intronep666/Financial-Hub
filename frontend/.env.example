# Frontend Environment Example (development)
# Copy to .env or customize as needed for local development

# API endpoint used by frontend to talk to backend
REACT_APP_API_URL=http://localhost:8000
VITE_API_URL=http://localhost:8000

# Progressive Web App (PWA)
REACT_APP_ENABLE_PWA=true
REACT_APP_ENABLE_OFFLINE=true

# AI and Voice Input features
REACT_APP_ENABLE_VOICE_INPUT=true
REACT_APP_ENABLE_AI_CATEGORIZATION=true

# Build / Source maps
GENERATE_SOURCEMAP=false
