# Frontend Environment Example (production)
# Copy to .env.production or use as a reference for your hosting provider

# Backend API endpoint for the production environment
REACT_APP_API_URL=https://your-production-backend-domain.com
VITE_API_URL=https://your-production-backend-domain.com

# Progressive Web App (PWA)
REACT_APP_ENABLE_PWA=true
REACT_APP_ENABLE_OFFLINE=false

# AI and Voice Input features (enable as appropriate)
REACT_APP_ENABLE_VOICE_INPUT=true
REACT_APP_ENABLE_AI_CATEGORIZATION=true

# Build / Source maps
GENERATE_SOURCEMAP=false
